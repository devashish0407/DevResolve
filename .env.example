# ── DevResolve Environment Variables ─────────────────────────────

# Application
APP_NAME=DevResolve
DEBUG=true
ENVIRONMENT=development

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devresolve
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devresolve

# Connection Pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Supabase Auth & JWT
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Application Security
# 32-byte url-safe base64 key generated with Fernet.generate_key()
API_KEY_ENCRYPTION_KEY=X9gP3W8qY6bZ4vC2mK1jL5nRt7uQ9sV3x0zA8eD6fH4=

# AI Reasoning Engines (Configurable in Settings UI or .env)
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...

# Frontend
VITE_API_URL=http://localhost:8000/api
